# ── Backend connection ────────────────────────────────────────────────────────
# URL of the FastAPI backend (default: http://127.0.0.1:8000)
BACKEND_URL=http://127.0.0.1:8000

# ── Optional ──────────────────────────────────────────────────────────────────
# Maximum iterations shown as the default in the UI (default: 5, range: 1–20)
# Should match the value set in backend/.env
MAX_ITERATIONS=5

# URL for the API Redundancy Util tool card on the home page (default: # = disabled)
REDUNDANCY_UTIL_URL=#
