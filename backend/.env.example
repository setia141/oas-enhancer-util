# ── Required ──────────────────────────────────────────────────────────────────
# OpenAI API key — get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Optional ──────────────────────────────────────────────────────────────────
# Maximum number of review→enhance iterations (default: 5, range: 1–20)
MAX_ITERATIONS=5

# Override if using a corporate AI gateway instead of api.openai.com
# OPENAI_BASE_URL=https://your-gateway.example.com/v1
