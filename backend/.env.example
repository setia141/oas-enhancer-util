# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Optional ──────────────────────────────────────────────────────────────────
# Override if using a corporate AI gateway instead of api.openai.com
# OPENAI_BASE_URL=https://your-gateway.example.com/v1

# ── Model and tuning ──────────────────────────────────────────────────────────
# BATCH_TOKENS and POSTMAN_TOKENS must not exceed your model's output token cap.
# Verify the cap from your provider before changing — setting it too high returns
# a 400 Bad Request from the API.
#
# BATCH_SIZE       — walker gaps per LLM call (lower = more focused, more calls)
# POSTMAN_BATCH_SIZE — Postman endpoints per LLM call (1 = maximum coverage)
#
# gpt-4.1-mini  (confirmed cap: 32 768)
# SUGGESTER_MODEL=gpt-4.1-mini
# BATCH_SIZE=50
# BATCH_TOKENS=32768
# POSTMAN_BATCH_SIZE=2
# POSTMAN_TOKENS=32768
#
# gpt-4.1-nano  (confirmed cap: 32 768)
# SUGGESTER_MODEL=gpt-4.1-nano
# BATCH_SIZE=50
# BATCH_TOKENS=32768
# POSTMAN_BATCH_SIZE=2
# POSTMAN_TOKENS=32768
#
# gpt-5.1-mini  (verify output token cap with your provider before deploying)
# SUGGESTER_MODEL=gpt-5.1-mini
# BATCH_SIZE=200
# BATCH_TOKENS=65536
# POSTMAN_BATCH_SIZE=5
# POSTMAN_TOKENS=65536
#
# gpt-5.1-nano  (verify output token cap with your provider before deploying)
# SUGGESTER_MODEL=gpt-5.1-nano
# BATCH_SIZE=200
# BATCH_TOKENS=65536
# POSTMAN_BATCH_SIZE=5
# POSTMAN_TOKENS=65536
